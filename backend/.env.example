# Application
APP_NAME="Overseas Visa Chatbot API"
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Security
# REQUIRED (min 32 chars). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Placeholder values are rejected at startup.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/visa_chatbot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_AUTO_CREATE_TABLES=False
SQL_ECHO=False

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Ollama (Local LLM and embeddings)
# Run `ollama serve`, and pull required models:
#   ollama pull llama3.2:3b
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Seconds a non-streaming answer may take in total (CPU ~7 tok/s); streaming idle gap between tokens
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
OLLAMA_STREAM_IDLE_TIMEOUT_SECONDS=90
# Model context window; keep thinking off on CPU (some builds, e.g. qwen3:4b, ignore it)
OLLAMA_NUM_CTX=4096
OLLAMA_THINK=False

# LLM gateway: per-role models (unset = OLLAMA_MODEL) and the call queue
# LLM_MODEL_PLANNER=llama3.2:3b
# LLM_MODEL_ANSWER=llama3.2:3b
# Monitor / backup model (M0.4b, measured on an i5-10210U + MX330): phi4-mini judged claims 92% correctly
# vs 56% for llama3.2:3b, and never accepted a false claim. Requires: ollama pull phi4-mini
# Unset LLM_MODEL_VERIFIER / LLM_FALLBACK_MODEL to run everything on OLLAMA_MODEL.
LLM_MODEL_VERIFIER=phi4-mini
# Backup model used when the primary times out, errors or replies empty
LLM_FALLBACK_MODEL=phi4-mini
# Keep the monitor off the GPU so both models stay loaded (swap ~0 s instead of ~30 s on a 2 GB GPU). JSON list.
LLM_CPU_ONLY_MODELS=["phi4-mini"]
# Input guardrail second layer (M4.5): classifies uncertain and verified-path messages; refuses only harmful /
# injection verdicts at or above the confidence. Kept on the CPU automatically (it would evict the answer model).
LLM_MODEL_MONITOR=qwen3:4b
MONITOR_ENABLED=True
MONITOR_DENY_CONFIDENCE=0.8
LLM_MAX_CONCURRENT_CALLS=1
LLM_QUEUE_TIMEOUT_SECONDS=300

# Request traces: one PII-redacted record per chat request, deleted after the retention period
TRACES_ENABLED=True
TRACE_RETENTION_DAYS=30

# Verified path: also ask the model whether each claim follows from its source (advisory: marks "partially verified")
VERIFY_CLAIMS_WITH_MODEL=True
# Verified path: one more round for a part that isn't verified (refined search), before this many seconds
VERIFIED_MAX_ROUNDS=2
VERIFIED_RETRY_BEFORE_SECONDS=150

# Triage (fast vs verified path): off | shadow (decide and trace only, answers unchanged) | on
AGENT_MODE=shadow
# Verified-path queue (AGENT_MODE=on): per-user limits and the first wait estimate
VERIFIED_JOBS_IN_FLIGHT_PER_USER=3
VERIFIED_JOBS_PER_HOUR=10
VERIFIED_JOB_ESTIMATE_SECONDS=90

# RAG generation (tuned with scripts/eval_rag.py on llama3.2:3b: 16/17 stable, ~21 s/answer on a 4-core CPU)
RAG_TOP_K=4
RAG_CONTEXT_CHARS=4000
RAG_MULTI_PART_CONTEXT_CHARS=6000
RAG_MAX_ANSWER_TOKENS=450
RAG_TEMPERATURE=0.0
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Vector Database - Chroma (local persistent storage)
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Vector Database - Pinecone (production alternative)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=visa-chatbot

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# Seconds before a task held by a dead worker is redelivered; must exceed the longest task (answers: 5 min)
CELERY_VISIBILITY_TIMEOUT_SECONDS=900

# Stripe (optional payments)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_REVIEW_PRICE_ID=price_your-review-price-id

# Firebase (optional cloud storage / FCM)
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FCM_SERVER_KEY=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@pendu.app
FROM_NAME="Pendu Visa Assistant"

# Sentry (monitoring)
SENTRY_DSN=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8081"]
# Development only: allow any localhost port. Keep False in production.
CORS_ALLOW_LOCALHOST_REGEX=True
# Reverse-proxy IPs whose X-Forwarded-For header is trusted (JSON list). Empty = trust none.
TRUSTED_PROXY_IPS=[]

# Scraping & Crawler
MAX_CONCURRENT_SCRAPES=5
SCRAPE_TIMEOUT_SECONDS=30
USER_AGENT=VisaChatbot/1.0 (+https://yourdomain.com/bot)
CRAWLER_MAX_CONCURRENT_WORKERS=10
CRAWLER_DEFAULT_MAX_DEPTH=3
CRAWLER_DEFAULT_MAX_PAGES=10000
CRAWLER_FRONTIER_TTL_DAYS=7
CRAWLER_RESPONSE_CACHE_TTL=86400
