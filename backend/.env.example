# Application
APP_NAME="Overseas Visa Chatbot API"
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/visa_chatbot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Provider: "gemini" (cloud, default) or "ollama" (local)
LLM_PROVIDER=gemini

# Google Gemini API (used when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your-google-gemini-api-key-here
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Ollama (used when LLM_PROVIDER=ollama — run `ollama serve` first)
# Pull a model first: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (optional - only if you prefer OpenAI embeddings over Google)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Database - Chroma (local dev)
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Vector Database - Pinecone (production)
# VECTOR_DB_TYPE=pinecone
# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_ENVIRONMENT=us-west1-gcp
# PINECONE_INDEX_NAME=visa-chatbot

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_REVIEW_PRICE_ID=price_your-review-price-id

# Firebase (for storage if needed)
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Sentry (monitoring)
SENTRY_DSN=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# Scraping
MAX_CONCURRENT_SCRAPES=5
SCRAPE_TIMEOUT_SECONDS=30
USER_AGENT=VisaChatbot/1.0 (+https://yourdomain.com/bot)
