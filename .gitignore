# ============================================================
# Pendu (visa-rag-llm) — root .gitignore
# Stack: FastAPI (backend/) + Next.js 14 (frontend/)
# ============================================================

# ---------- Secrets & environment ----------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
credentials*.json
service-account*.json

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
dist/
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/

# ---------- Node / Next.js ----------
node_modules/
.next/
out/
.turbo/
.vercel/
coverage/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Runtime data (never commit user data or generated stores) ----------
**/chroma_data/
**/uploads/
**/logs/
*.log
*.db
*.sqlite
*.sqlite3
dump.rdb
celerybeat-schedule*
celerybeat.pid

# ---------- Build artifacts ----------
/build/
backend/build/

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
*.iml
.vscode/
.history/

# ---------- AI-assistant / tool workspaces ----------
.kiro/
.claude/settings.local.json
.antigravity/

# ---------- Internal planning, audits & scratch (keep local, not public) ----------
project_plan/
GITHUB_UPLOAD_WARNINGS.md
old_commit_history.txt
*.local.md
scratch/
tmp/
